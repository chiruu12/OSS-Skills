#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
SKILLS_DIR="$SCRIPT_DIR/skills"
LOCAL_MODE=false

# Parse args
for arg in "$@"; do
  case "$arg" in
    --local) LOCAL_MODE=true ;;
    --help|-h)
      echo "Usage: ./setup [--local]"
      echo ""
      echo "  --local    Install skills relative to current project (.claude/skills/)"
      echo "             instead of global (~/.claude/skills/)"
      echo ""
      echo "OSS-Skills: 15 Claude Code skills for open source contributors."
      echo "https://github.com/chiruu12/OSS-Skills"
      exit 0
      ;;
    *)
      echo "Unknown option: $arg"
      echo "Run ./setup --help for usage."
      exit 1
      ;;
  esac
done

echo "OSS-Skills Setup"
echo "================"
echo ""

# Determine install target
if [ "$LOCAL_MODE" = true ]; then
  TARGET_DIR="$(pwd)/.claude/skills"
  echo "Installing to project: $TARGET_DIR"
else
  TARGET_DIR="$HOME/.claude/skills"
  echo "Installing globally: $TARGET_DIR"
fi

mkdir -p "$TARGET_DIR"

# Check prerequisites
echo ""
echo "Checking prerequisites..."

if ! command -v gh &>/dev/null; then
  echo "  ERROR: 'gh' CLI not found. All skills require it."
  echo "  Install: https://cli.github.com/"
  echo ""
  echo "  Skills will be installed, but they won't work without gh."
  echo "  Install gh, run 'gh auth login', then try the skills."
else
  echo "  gh CLI: found"
  if gh auth status &>/dev/null 2>&1; then
    echo "  gh auth: authenticated"
  else
    echo "  WARNING: gh not authenticated. Run 'gh auth login' before using skills."
  fi
fi

if ! command -v git &>/dev/null; then
  echo "  ERROR: git not found. Cannot continue."
  exit 1
else
  echo "  git: found"
fi

echo ""

# Install skills
SKILLS=(
  oss-evaluate-repo
  oss-find-issue
  oss-prep-to-contribute
  oss-setup-dev-env
  oss-contribute
  oss-write-tests
  oss-write-docs
  oss-submit-pr
  oss-post-pr
  oss-debug-ci
  oss-second-contribution
  oss-review-prs
  oss-find-real-issues
  oss-explore-repo
  oss-learn-stack
)

echo "Installing ${#SKILLS[@]} skills..."

INSTALLED=0
for skill in "${SKILLS[@]}"; do
  skill_target="$TARGET_DIR/$skill"
  mkdir -p "$skill_target"
  if cp "$SKILLS_DIR/$skill/SKILL.md" "$skill_target/SKILL.md" 2>/dev/null; then
    echo "  $skill"
    INSTALLED=$((INSTALLED + 1))
  else
    echo "  FAILED: $skill"
  fi
done

if [ "$INSTALLED" -ne "${#SKILLS[@]}" ]; then
  echo ""
  echo "WARNING: Only $INSTALLED/${#SKILLS[@]} skills installed. Check file permissions."
fi

echo ""
echo "Done. $INSTALLED skills installed."
echo ""
echo "Available skills:"
echo ""
echo "  Evaluation:"
echo "  /oss-evaluate-repo       Assess repo health before investing time"
echo ""
echo "  Contribution pipeline:"
echo "  /oss-find-issue          Find unclaimed issues matching your skills"
echo "  /oss-prep-to-contribute  Prepare to contribute (docs, eligibility, knowledge check)"
echo "  /oss-setup-dev-env       Set up dev environment for unfamiliar repos"
echo "  /oss-contribute          Research the issue, you describe the logic"
echo "  /oss-submit-pr           Submit a PR following repo guidelines"
echo "  /oss-post-pr             Handle PR review feedback"
echo ""
echo "  Contribution types:"
echo "  /oss-write-tests         Write tests as a standalone contribution"
echo "  /oss-write-docs          Contribute documentation improvements"
echo ""
echo "  CI and review:"
echo "  /oss-debug-ci            Debug CI failures in unfamiliar pipelines"
echo "  /oss-review-prs          Review PRs to learn and build trust"
echo ""
echo "  Growth:"
echo "  /oss-second-contribution Plan your path to regular contributor"
echo ""
echo "  Research:"
echo "  /oss-find-real-issues    Find real code issues not in the tracker"
echo "  /oss-explore-repo        Guided codebase exploration"
echo "  /oss-learn-stack         Learn unfamiliar tech from the repo's own code"
echo ""
echo "Start with: /oss-evaluate-repo, /oss-find-issue, or /oss-explore-repo"
